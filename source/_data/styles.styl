@font-face
  font-family: 'ZCOOL KuaiLe'
  src: url('../fonts/zcool-kuaile/ZCOOLKuaiLe-Regular.ttf') format('truetype')
  font-style: normal
  font-weight: 400
  font-display: swap

body
  --body-bg-color: #f5f3eb
  --content-bg-color: #fffdf7
  --theme-color: #215c40
  --blog-accent: #215c40
  --blog-soft: #e5eee3
  --blog-rule: #c7d0c2
  --card-ink: #243042
  --card-surface: #fffdf7
  --card-first: #e8eaee
  --card-font: 'ZCOOL KuaiLe', 'Kaiti SC', KaiTi, cursive

.site-brand-container
  background: var(--blog-accent)

.site-title,
.site-subtitle,
.site-nav .menu-item > a,
.sidebar-nav,
.site-overview-wrap
  font-family: var(--card-font)

.blog-home h1,
.blog-home-summary
  font-family: var(--card-font)
  font-weight: 400

.blog-home h1
  border: 0
  border-bottom: 1px solid var(--blog-rule)
  color: var(--text-color)
  font-size: clamp(2.35rem, 5vw, 4.25rem)
  line-height: 1.15
  margin: 0 0 1.5rem
  overflow-wrap: anywhere
  padding-bottom: 1.25rem

.blog-home-summary,
.blog-home-media
  display: flex
  flex-wrap: wrap
  gap: .8rem 1.25rem

.blog-home-summary
  align-items: center
  font-size: 1.125rem
  justify-content: space-between

.blog-home-summary ul
  margin: 0
  padding-left: 1.25rem

.blog-home .blog-home-button
  background: var(--blog-accent)
  border: 0
  border-radius: .45rem
  color: var(--content-bg-color)
  display: inline-block
  font-weight: 700
  padding: .55rem 1rem

.blog-home .blog-home-button:hover
  text-decoration: underline

.blog-home-media
  align-items: flex-start
  margin-top: 1.5rem

.blog-home-media img
  display: block
  height: auto
  margin: 0
  max-width: 100%

ul.category-cards
  align-items: start
  display: grid
  gap: 22px
  grid-template-columns: repeat(3, minmax(0, 1fr))
  list-style: none
  padding: 0

.category-cards > li:nth-child(2)
  margin-top: 28px

.category-cards > li:nth-child(3)
  margin-top: 56px

.category-card
  background: var(--card-surface)
  border: 2px solid var(--card-ink)
  border-radius: 14px 10px 15px 11px
  color: var(--card-ink)
  padding: 1rem 1.25rem

.category-cards > li:first-child .category-card
  background: var(--card-first)

.category-cards > li:nth-child(2) .category-card
  border-radius: 10px 15px 11px 14px

.category-cards > li:nth-child(3) .category-card
  border-radius: 15px 11px 14px 10px

.category-card h2
  border: 0
  font: 400 1.65rem/1.3 var(--card-font)
  margin: .5rem 0
  overflow-wrap: anywhere

.category-card h2 a
  border: 0
  color: var(--card-ink)

.category-card h2 a:hover,
.category-post-title:hover
  text-decoration: underline

.category-count
  border: 1px solid currentColor
  border-radius: 999px
  display: inline-block
  font-size: .875rem
  padding: .1rem .55rem

ul.category-posts
  border-top: 1px solid var(--blog-rule)
  list-style: none
  margin: .75rem 0 0
  padding: 0

.category-posts li
  border-bottom: 1px solid var(--blog-rule)
  overflow-wrap: anywhere
  padding: .55rem .25rem

.category-posts li:hover
  background: var(--blog-soft)

.category-post-heading
  text-align: left

.category-posts .category-post-title
  border: 0
  font: 400 1.35rem/1.3 var(--card-font)

.category-post-heading time
  color: var(--text-color)
  font: .75rem ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  margin-inline-start: .35rem
  white-space: nowrap

.category-post-meta
  align-items: center
  color: var(--text-color)
  display: flex
  flex-wrap: wrap
  font-size: .88rem
  gap: .25rem .45rem
  justify-content: flex-start
  margin-top: .25rem

.category-post-meta .category-tag,
.posts-collapse .post-content .category-post-meta .category-tag
  background: var(--blog-soft)
  border: 0
  border-radius: .5rem
  color: var(--blog-accent)
  font-size: .8rem
  padding: .05rem .45rem

.category-more
  color: var(--blog-accent)
  font-weight: 700

.category.posts-collapse,
.archive.posts-collapse,
.tag.posts-collapse
  .post-content
    margin: 0

    &::before
      display: none

  .collection-header
    color: var(--card-ink)
    font: 400 1.65rem/1.3 var(--card-font)
    margin-left: 0

  .collection-title::before,
  .collection-year::before,
  .post-header::before
    display: none

  .collection-year
    margin: 1.5rem 0 .5rem

  .post-header
    align-items: baseline
    border-bottom: 1px solid var(--blog-rule)
    display: flex
    gap: .75rem
    margin: 0
    padding: .55rem .25rem

  .post-header:hover
    background: var(--blog-soft)

  .post-meta-container
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
    margin: 0
    white-space: nowrap

  .post-title
    min-width: 0

  .post-title-link
    font: 400 1.35rem/1.3 var(--card-font)
    overflow-wrap: anywhere

  .post-title-link:hover
    text-decoration: underline

.blog-home a:focus-visible,
.category-cards a:focus-visible,
.posts-collapse a:focus-visible
  outline: 2px solid var(--blog-accent)
  outline-offset: 3px

@media (max-width: 700px)
  ul.category-cards
    grid-template-columns: 1fr
    gap: .8rem

  .category-cards > li:nth-child(n)
    margin-top: 0
